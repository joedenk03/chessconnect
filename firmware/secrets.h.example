// secrets.h.example
//
// Copy this file to `secrets.h` and fill in your own credentials before building.
// `secrets.h` is gitignored and will not be tracked by git — do not commit real
// credentials to a public repository.
//
// To create a Lichess personal API token, visit:
//   https://lichess.org/account/oauth/token
// Required scopes: challenge:read, challenge:write, board:play

#ifndef SECRETS_H
#define SECRETS_H

#define SECRET_WIFI_SSID     "your-wifi-ssid"
#define SECRET_WIFI_PASS     "your-wifi-password"
#define SECRET_LICHESS_TOKEN "your-lichess-api-token"

#endif  // SECRETS_H
